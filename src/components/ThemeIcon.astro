---
---
<div class="theme-switcher">
  <button data-theme-choice="light" aria-label="Tema claro">☀️</button>
  <button data-theme-choice="dark" aria-label="Tema oscuro">🌙</button>
  <button data-theme-choice="system" aria-label="Tema del sistema">🖥️</button>
</div>

<style>
  .theme-switcher {
    display: inline-flex;
    gap: 0.25rem;
    padding: 0.25rem;
    border-radius: 8px;
    background-color: var(--border);
  }

  .theme-switcher button {
    border: 0;
    background: none;
    padding: 0.35rem 0.5rem;
    border-radius: 6px;
    cursor: pointer;
    line-height: 1;
    opacity: 0.5;
    transition: background-color 0.2s ease, opacity 0.2s ease;
  }

  .theme-switcher button:hover {
    opacity: 0.8;
  }

  .theme-switcher button[aria-pressed="true"] {
    background-color: var(--accent);
    opacity: 1;
  }
</style>

<style is:global>
  /* Animación tipo "reveal": el nuevo tema se expande en círculo
     desde el botón que se clickeó hasta cubrir toda la pantalla. */
  ::view-transition-old(root) {
    animation: none;
  }

  ::view-transition-new(root) {
    animation: theme-reveal 0.5s ease-in-out;
  }

  @keyframes theme-reveal {
    from {
      clip-path: circle(0% at var(--theme-toggle-x, 50%) var(--theme-toggle-y, 50%));
    }
    to {
      clip-path: circle(150% at var(--theme-toggle-x, 50%) var(--theme-toggle-y, 50%));
    }
  }
</style>

<script is:inline>
  const THEME_KEY = "theme"; // "light" | "dark" | "system"

  const getStoredPreference = () => localStorage.getItem(THEME_KEY) ?? "system";

  const systemPrefersDark = () =>
    window.matchMedia("(prefers-color-scheme: dark)").matches;

  const applyPreference = (preference) => {
    const isDark = preference === "dark" || (preference === "system" && systemPrefersDark());
    document.documentElement.classList.toggle("dark", isDark);

    document.querySelectorAll("[data-theme-choice]").forEach((btn) => {
      btn.setAttribute("aria-pressed", String(btn.dataset.themeChoice === preference));
    });
  };

  // Aplicar al cargar la página
  applyPreference(getStoredPreference());

  // Si está en "system" y el usuario cambia el tema del SO en vivo, seguirlo
  window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
    if (getStoredPreference() === "system") {
      applyPreference("system");
    }
  });

  // Click en cualquiera de los 3 botones
  document.querySelectorAll("[data-theme-choice]").forEach((btn) => {
    btn.addEventListener("click", (event) => {
      const preference = btn.dataset.themeChoice;
      const setAndApply = () => {
        localStorage.setItem(THEME_KEY, preference);
        applyPreference(preference);
      };

      if (document.startViewTransition) {
        // Le decimos al CSS desde dónde debe "explotar" el círculo:
        // el punto exacto donde el usuario dio clic.
        const { clientX, clientY } = event;
        document.documentElement.style.setProperty("--theme-toggle-x", `${clientX}px`);
        document.documentElement.style.setProperty("--theme-toggle-y", `${clientY}px`);

        document.startViewTransition(setAndApply);
      } else {
        setAndApply();
      }
    });
  });
</script>