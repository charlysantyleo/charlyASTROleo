---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogPost from '../components/BlogPost.astro';
const allPosts = Object.values(import.meta.glob('../pages/posts/*.md', { eager: true }));
const pageTitle = "Mailen te amo, debi hablarte desde el prope aaaah"
---
<BaseLayout pageTitle={pageTitle}>
  <p>Me tardo mucho en responderle, pero es porque me pongo nervioso con cada mensaje xdddd</p>
  <ul>
    {allPosts.map((post: any) => <BlogPost url={post.url} title={post.frontmatter.title} />)}
  </ul>
</BaseLayout>