---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "About Me";
const identity = {
  firstName: "Santiago",
  country: "Mexico",
  occupation: "Dormir",
  hobbies: ["Ver a Mailen", "Hablar con Mailen", "Seguramente besarla, pero no lo he hecho"],
};

const skills = ["HTML", "CSS", "JavaScript", "React", "Astro", "Writing Docs"];

const happy = true;
const finished = true;
const goal = 3;

const skillColor = "crimson";
const fontweight = "bold";
const textCase = "uppercase";
---

<BaseLayout pageTitle={pageTitle}>
  <p>Unos pequeños factos sobre mí:</p>
  <ul>
    <li>Me {identity.firstName}.</li>
    <li>Vivo en {identity.country} me gusta mucho Mailen y {identity.occupation}.</li>
    {identity.hobbies.length >= 2 &&
      <li>Mis hobbies son: {identity.hobbies[0]} y {identity.hobbies[1]}</li>
    }
  </ul>
  <p>Medio se chambear con:</p>
  <ul>
    {skills.map((skill) => <li class="skill">{skill}</li>)}
  </ul>
  {happy && <p>Eta practica fue muy buena y aprendi mucho.</p>}

  {finished && <p>Termine este tutorial!</p>}

  {goal === 3 ? <p>Mi objetivo es casarme con Mailen.</p> : <p>Mi objetivo es tener hijos con Mailen.</p>}
</BaseLayout>

<style define:vars={{skillColor, fontweight, textCase}}>
  .skill {
    color: var(--skillColor);
    font-weight: var(--fontweight);
    text-transform: var(--textCase);
  }
</style>